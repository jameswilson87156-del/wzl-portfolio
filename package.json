{
  "name": "wzl-engineering-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run build:raw && npm run prepare:static && npm run verify:static",
    "build:raw": "vinext build",
    "prepare:static": "node scripts/prepare-static-release.mjs",
    "verify:static": "node scripts/verify-static-release.mjs",
    "preview:static": "node scripts/static-preview-server.mjs",
    "start": "npm run preview:static",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/static-release.test.mjs tests/security-patch-contract.test.mjs tests/toolchain-cleanup-contract.test.mjs tests/phase1d2b-release-contract.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .package-stage --ignore-pattern build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16"
  },
  "type": "module"
}
