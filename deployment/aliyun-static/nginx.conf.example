# Review-only draft for the upcoming Aliyun staging deployment.
# Do not enable until Phase 1D.3 server backup and configuration checks pass.
map $uri $wzl_cache_control {
    default                                         "public, max-age=86400";
    ~/$                                             "no-cache";
    ~*\.html$                                       "no-cache";
    ~*\.rsc$                                        "no-cache";
    ~^/assets/.*-[A-Za-z0-9_-]+\.(?:css|js)$        "public, max-age=31536000, immutable";
    ~^/projects/.*/responsive/.*\.webp$             "public, max-age=31536000, immutable";
    ~^/projects/.*\.png$                            "public, max-age=31536000, immutable";
    ~*\.(?:png|jpg|jpeg|webp|svg)$                  "public, max-age=2592000";
    ~*\/(?:robots\.txt|sitemap\.xml)$              "public, max-age=3600";
    ~*\.(?:ico)$                                    "public, max-age=604800";
}

server {
    listen 80;
    listen [::]:80;

    server_name wzl8.top www.wzl8.top;

    root /var/www/wzl-portfolio/current;
    index index.html;
    autoindex off;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        application/octet-stream
        image/svg+xml;

    add_header Cache-Control $wzl_cache_control always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Exact match wins before regex locations. Query strings do not affect it.
    location = /.rsc {
        try_files /index.rsc =404;
        default_type application/octet-stream;
    }

    location ~ \.rsc$ {
        try_files $uri =404;
        default_type application/octet-stream;
    }

    location ~* ^/assets/ {
        try_files $uri =404;
    }

    location ~* \.(?:png|jpg|jpeg|webp|svg|ico)$ {
        try_files $uri =404;
    }

    # Exact /.rsc remains available; other slash-dot paths stay blocked.
    location ~ (^|/)\. {
        deny all;
    }

    location ~* \.(?:env|pem|key|p12|pfx|bak|old|orig|swp)$ {
        deny all;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # HTTPS is intentionally deferred. Add a reviewed certificate configuration
    # only after DNS is approved and the HTTP static release passes production checks.
}
